    function applyGauge(element, ffValue) {
        if (!element || ffValue == null || isNaN(ffValue)) return;

        const low_ff = getSetting('qaFfRangeLow', 2);
        const high_ff = getSetting('qaFfRangeHigh', 4);
        const max_ff = getSetting('qaFfRangeMax', 8);

        const low_mid_percent = 33;
        const mid_high_percent = 66;

        const ff_lower = Math.max(1, Math.min(ffValue, max_ff));
        let percent;

        if (ff_lower <= low_ff) {
            percent = ((ff_lower - 1) / Math.max(0.01, low_ff - 1)) * low_mid_percent;
        } else if (ff_lower <= high_ff) {
            percent = ((ff_lower - low_ff) / Math.max(0.01, high_ff - low_ff)) * (mid_high_percent - low_mid_percent) + low_mid_percent;
        } else {
            percent = ((ff_lower - high_ff) / Math.max(0.01, max_ff - high_ff)) * (100 - mid_high_percent) + mid_high_percent;
        }

        percent = Math.max(0, Math.min(100, percent));

        element.classList.add('qa-gauge');
        element.style.setProperty('--band-percent', `${percent}%`);

        let wrapper = element.querySelector('.qa-marker-wrapper');
        if (!wrapper) {
            wrapper = document.createElement('div');
            wrapper.className = 'qa-marker-wrapper';
            element.appendChild(wrapper);
        }

        const color = badgeColorForFF(ffValue);
        wrapper.innerHTML = `
            <svg class="qa-arrow" viewBox="0 0 20 13">
                <path fill-rule="evenodd" fill="${color}" stroke="#000000" stroke-width="1.5" d="M 0,0 H 13 20 L 10,12 Z"></path>
            </svg>
        `;
    }

