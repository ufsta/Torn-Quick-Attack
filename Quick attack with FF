function fetchHospitalData(factionId) {
    const key = getTornKey();
    if (!key || key.length !== 16) return;
    GM_xmlhttpRequest({
        method: 'GET',
        url: `https://api.torn.com/v2/faction?id=${factionId}&selections=members,timestamp&key=${key}&comment=QuickAttackHospital&timestamp=${Date.now() % 1000 + 10}`,
        onload: function (r) {
            try {
                const data = JSON.parse(r.responseText);
                if (data.error) return;
                if (data.timestamp) tornSkewMs = data.timestamp * 1000 - Date.now();
                const list = Array.isArray(data.members) ? data.members : Object.values(data.members || {});
                list.forEach(m => {
                    const st = m.status || {};
                    hospUntil[String(m.id)] = (st.state === 'Hospital' || st.state === 'Jail') ? (st.until || 0) : 0;
                });
                refreshHospitalUi();
                resortNow();
            } catch (e) {}
        }
    });
}

function refreshHospitalUi() {
    const nowSec = tornNowMs() / 1000;
    document.querySelectorAll('ul.members-list li.enemy, ul.members-list li.your').forEach(li => {
        const sd = li.querySelector('div.status');
        if (!sd) return;
        const xid = getPlayerIdFromLink(li.querySelector('a[href*="profiles.php?XID="]'));
        const until = xid ? (hospUntil[xid] || 0) : 0;
        const remaining = until ? Math.round(until - nowSec) : 0;
        const isHosp = sd.classList.contains('hospital') || sd.classList.contains('jail');
        if (isHosp && remaining > 0) {
            sd.style.setProperty('--qa-content', `"${fmtHosp(remaining)}"`);
            sd.setAttribute('data-qa-hosp', remaining < 300 ? 'soon' : 'true');
        } else if (sd.hasAttribute('data-qa-hosp')) {
            sd.removeAttribute('data-qa-hosp');
            sd.style.removeProperty('--qa-content');
        }
    });
}

function startHospitalWatcher() {
    if (hospWatcherStarted) return;
    hospWatcherStarted = true;
    const poll = () => { if (!document.hidden) getWarFactionIds().forEach(fetchHospitalData); };
    poll();
    setInterval(poll, 10000);
    setInterval(refreshHospitalUi, 1000);
    setInterval(() => { if (!document.hidden) resortNow(); }, 5000);
}

// Groups: 0 Okay, 1 Hospital/Jail (until = seconds), 2 Abroad, 3 Traveling, 4 other, 5 no status cell
function getStatusInfo(row) {
    const sd = row.querySelector('div.status');
    if (!sd) return { g: 5 };
    const xid = getPlayerIdFromLink(row.querySelector('a[href*="profiles.php?XID="]'));
    const until = xid ? (hospUntil[xid] || 0) : 0;
    if (sd.classList.contains('hospital') || sd.classList.contains('jail')) {
        if (until && until <= tornNowMs() / 1000) return { g: 0 }; // already out
        return { g: 1, until: until || Infinity };
    }
    if (sd.classList.contains('abroad')) return { g: 2 };
    if (sd.classList.contains('traveling')) return { g: 3 };
    if ((sd.textContent || '').trim() === 'Okay') return { g: 0 };
    return { g: 4 };
}

