}

function snapshotFilters() {
    const p = { sortBy: currentSortMode, colDisplay: document.getElementById('qa-col-display').value };
    Object.entries(VALUE_IDS).forEach(([k, id]) => { p[k] = document.getElementById(id)?.value ?? ''; });
    Object.entries(CHECK_IDS).forEach(([k, id]) => { p[k] = document.getElementById(id)?.checked ?? true; });
    return p;
}

function applyPreset(p) {
    const full = Object.assign({}, FILTER_DEFAULTS, p);
    Object.entries(VALUE_IDS).forEach(([k, id]) => {
        const el = document.getElementById(id);
        if (el) el.value = full[k] ?? '';
    });
    Object.entries(CHECK_IDS).forEach(([k, id]) => {
        const el = document.getElementById(id);
        if (el) el.checked = full[k] !== false;
    });
    if (full.colDisplay) document.getElementById('qa-col-display').value = full.colDisplay;
    currentSortMode = full.sortBy || 'none';
    filterEnabled = true;
    updateSortButtonLabel();
    saveAndApplyFilters();
}

