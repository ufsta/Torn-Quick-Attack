    function isSpyValid(timestamp) {
        if (!timestamp) return false;
        const thirtyDaysInSeconds = 30 * 24 * 60 * 60;
        const currentSeconds = Math.floor(Date.now() / 1000);
        return (currentSeconds - timestamp) <= thirtyDaysInSeconds;
    }

    function formatTBS(num) {
        if (num >= 1e12) return +(num / 1e12).toFixed(2) + 't';
        if (num >= 1e9) return +(num / 1e9).toFixed(2) + 'b';
        if (num >= 100e6) return +(num / 1e6).toFixed(0) + 'm';
        if (num >= 10e6) return +(num / 1e6).toFixed(1) + 'm';
        if (num >= 1e6) return +(num / 1e6).toFixed(2) + 'm';
        if (num >= 1e3) return +(num / 1e3).toFixed(0) + 'k';
        return num.toString();
    }

    function getPlayerIdFromLink(link) {
        if (!link) return null;
        const href = typeof link === 'string' ? link : link.href;
        if (!href) return null;

        try {
            const match = href.match(/(?:XID|userId|userID|user2ID|NID)=([0-9]+)/i);
            if (match) return match[1];

            const url = new URL(href, window.location.origin);
            return url.searchParams.get("XID") ||
                   url.searchParams.get("userId") ||
                   url.searchParams.get("userID") ||
                   url.searchParams.get("user2ID") ||
                   url.searchParams.get("NID");
        } catch (e) {
            return null;
        }
    }

