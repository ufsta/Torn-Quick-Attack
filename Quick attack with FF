    function badgeColorForFF(ffValue) {
        if (ffValue == null || isNaN(ffValue)) return "#444444";

        const scheme = getSetting('qaColorScheme', 'classic');
        const palette = BUILTIN_PALETTES[scheme] || BUILTIN_PALETTES['classic'];

        const low_ff = getSetting('qaFfRangeLow', 2);
        const high_ff = getSetting('qaFfRangeHigh', 4);
        const max_ff = getSetting('qaFfRangeMax', 8);

        const low_mid_percent = 33;
        const mid_high_percent = 66;

        const ff_lower = Math.max(1, Math.min(ffValue, max_ff));
        let percent;

        if (ff_lower <= low_ff) {
            percent = ((ff_lower - 1) / Math.max(0.01, low_ff - 1)) * low_mid_percent;
        } else if (ff_lower <= high_ff) {
            percent = ((ff_lower - low_ff) / Math.max(0.01, high_ff - low_ff)) * (mid_high_percent - low_mid_percent) + low_mid_percent;
        } else {
            percent = ((ff_lower - high_ff) / Math.max(0.01, max_ff - high_ff)) * (100 - mid_high_percent) + mid_high_percent;
        }

        const ratio = Math.max(0, Math.min(10, Math.floor((percent / 100) * 10)));
        return palette[ratio] || "#444444";
    }

    function getContrastColor(hex) {
        if (!hex || hex.length < 7) return "white";
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        const brightness = r * 0.299 + g * 0.587 + b * 0.114;
        return brightness > 126 ? "black" : "white";
    }

    function formatDuration(totalSeconds) {
        const clamped = Math.max(0, Math.floor(totalSeconds));
        const hours = Math.floor(clamped / 3600);
        const minutes = Math.floor((clamped % 3600) / 60);
        const seconds = clamped % 60;
        const parts = [];
        if (hours > 0) parts.push(`${hours}h`);
        if (hours > 0 || minutes > 0) parts.push(`${minutes}m`);
        parts.push(`${seconds}s`);
        return parts.join(' ');
    }

    function formatTCT(unixSeconds) {
        if (!unixSeconds || isNaN(unixSeconds)) return '';
        const d = new Date(unixSeconds * 1000);
        const h = String(d.getUTCHours()).padStart(2, '0');
        const m = String(d.getUTCMinutes()).padStart(2, '0');
        return `${h}:${m}`;
    }

    function parseStatValue(str) {
        if (!str) return null;
        str = String(str).trim().toLowerCase();
        const match = str.match(/^([\d.,]+)\s*([kmbt])?$/);
        if (!match) return null;
        let num = parseFloat(match[1].replace(/,/g, ''));
        if (isNaN(num)) return null;
        const suffix = match[2];
        if (suffix === 'k') num *= 1e3;
        else if (suffix === 'm') num *= 1e6;
        else if (suffix === 'b') num *= 1e9;
        else if (suffix === 't') num *= 1e12;
        return num;
    }

    function getActivityStatus(row) {
        const wrap = row.querySelector('[class*="userStatusWrap"], [class*="userStatus"], [class*="statusWrap"]');
        if (wrap) {
            const label = (wrap.getAttribute('aria-label') || '').toLowerCase();
            if (label.includes('online')) return 'online';
            if (label.includes('idle') || label.includes('away')) return 'idle';
            if (label.includes('offline')) return 'offline';
        }

        const ariaEl = row.querySelector('[aria-label*="online" i], [aria-label*="offline" i], [aria-label*="idle" i]');
        if (ariaEl) {
            const label = ariaEl.getAttribute('aria-label').toLowerCase();
            if (label.includes('online')) return 'online';
            if (label.includes('idle') || label.includes('away')) return 'idle';
