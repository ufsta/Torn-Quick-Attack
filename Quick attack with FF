    function injectFlightStats() {
        if (!window.location.href.includes("profiles.php?XID=")) return;
        const profileStatus = document.querySelector('.profile-status');
        if (!profileStatus) return;

        const isTravelling = profileStatus.classList.contains('travelling') || profileStatus.querySelector('.travelling');
        if (!isTravelling) {
            if (flightInterval) clearInterval(flightInterval);
            const oldBox = document.getElementById('qa-flight-info');
            if (oldBox) oldBox.remove();
            return;
        }

        if (document.getElementById('qa-flight-info')) return;
        const xid = new URL(window.location.href).searchParams.get("XID");
        const apiKey = GM_getValue('ffApiKey', '');
        if (!xid || !apiKey) return;

        const description = profileStatus.querySelector('.description') || profileStatus;
        const container = document.createElement('div');
        container.id = 'qa-flight-info';
        container.style.cssText = "position: absolute; right: 10px; bottom: 4px; z-index: 10; text-align: right; font-size: 11px; color: #ffffff; text-shadow: 0 1px 3px rgba(0,0,0,0.9); pointer-events: none; line-height: 1.25;";
        description.style.position = 'relative';
        description.appendChild(container);

        GM_xmlhttpRequest({
            method: "GET",
            url: `https://ffscouter.com/api/v1/player-flights?key=${apiKey}&target=${xid}`,
            onload: function (response) {
                try {
                    const data = JSON.parse(response.responseText);
                    const current = data?.current || data?.result?.current;
                    if (!current || !current.earliest_arrival_time || !current.latest_arrival_time) {
                        container.innerText = "Landing: unavailable";
                        return;
                    }

                    const earliest = Number(current.earliest_arrival_time);
                    const latest = Number(current.latest_arrival_time);

                    function updateCountdown() {
                        const now = Date.now() / 1000;
                        const eRem = earliest - now;
                        const lRem = latest - now;
                        const eTCT = formatTCT(earliest);
                        const lTCT = formatTCT(latest);

                        let text = "";
                        if (lRem <= -300) text = "Landing: Late / Delayed";
                        else if (lRem <= 0) text = `Landing: Just landed (${lTCT} TCT)`;
                        else if (eRem <= 0) text = `Landing: Imminent - ${formatDuration(lRem)}<br>(${lTCT} TCT latest)`;
                        else text = `Landing: ${formatDuration(eRem)} - ${formatDuration(lRem)}<br>(${eTCT} - ${lTCT} TCT)`;
                        container.innerHTML = text;
                    }

                    updateCountdown();
                    if (flightInterval) clearInterval(flightInterval);
                    flightInterval = setInterval(updateCountdown, 1000);
                } catch (e) { console.error(e); }
            }
        });
    }

