    function executeFetch() {
        const apiKey = GM_getValue('ffApiKey', '');
        const targets = Array.from(pendingIDs);
        pendingIDs.clear();
        if (!targets.length) return;

        if (!apiKey) {
            targets.forEach(xid => {
                const spy = spyCache[xid];
                if (spy && isSpyValid(spy.timestamp) && spy.total > 0) {
                    statCache[String(xid)] = { statStr: formatTBS(spy.total), ffValue: null, isSpy: true };
                    updateBadgeText(xid, formatTBS(spy.total), true);
                    updateBadgeColor(xid, 3.0);
                } else {
                    updateBadgeText(xid, 'No Key', false);
                }
            });
            return;
        }

        GM_xmlhttpRequest({
            method: "GET",
            url: `https://ffscouter.com/api/v1/get-stats?key=${apiKey}&targets=${targets.join(',')}`,
            onload: function (response) {
                try {
                    const data = JSON.parse(response.responseText);
                    let payloadArray = Array.isArray(data) ? data : (data.data || data.targets || []);

                    targets.forEach(xid => {
                        const info = payloadArray.find(p => String(p?.player_id) === String(xid) || String(p?.id) === String(xid)) || data.data?.[xid] || data[xid];

                        let statStr = 'N/A';
                        let ffValue = null;
                        let isSpy = false;

                        if (info) {
                            const statData = info.stats || info;
                            let rawStatStr = statData.bs_estimate_human || statData.bs_estimate || 'N/A';

                            if (rawStatStr !== 'N/A') {
                                const rawNum = parseStatValue(rawStatStr);
                                if (rawNum !== null) statStr = formatTBS(rawNum);
                                else statStr = rawStatStr;
                            }

                            const rawFF = statData.value ?? statData.ff ?? statData.fair_fight ?? info.value ?? info.ff ?? info.fair_fight ?? null;
                            ffValue = rawFF != null ? parseFloat(rawFF) : null;
                        }

                        const spy = spyCache[xid];
                        if (spy && isSpyValid(spy.timestamp) && spy.total > 0) {
                            statStr = formatTBS(spy.total);
                            isSpy = true;
                            if (ffValue == null) ffValue = 3.0;
                        }

                        if (statStr === 'N/A' && !isSpy) {
                            updateBadgeText(xid, 'N/A');
                            return;
                        }

                        statCache[String(xid)] = { statStr, ffValue, isSpy };
                        updateBadgeText(xid, statStr, isSpy);
                        updateBadgeColor(xid, ffValue);
                    });
                } catch (e) {
                    targets.forEach(xid => updateBadgeText(xid, 'Err'));
                }
            },
            onerror: function () {
                targets.forEach(xid => updateBadgeText(xid, 'Err'));
            }
        });
    }

    function fetchYataSpies(btnElement) {
        const key = GM_getValue('yataApiKey', '');
        if (!key) { alert("Please enter a YATA API Key and save first."); return; }

        btnElement.innerText = "Fetching...";
        btnElement.disabled = true;

        GM_xmlhttpRequest({
            method: "GET",
            url: `https://yata.yt/api/v1/spies/?key=${key}`,
            onload: function (response) {
                btnElement.innerText = "Import YATA Spies";
                btnElement.disabled = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data.error) return alert("YATA Error: " + data.error);

                    let imported = 0;
                    for (const [xid, spy] of Object.entries(data.spies || {})) {
                        spyCache[xid] = {
                            total: spy.total,
                            timestamp: spy.total_timestamp,
                            source: 'YATA'
                        };
                        imported++;
                    }
                    GM_setValue('qaSpyCache', spyCache);
                    alert(`Successfully imported ${imported} spies from YATA!`);
                    location.reload();
                } catch (e) { alert("Failed to parse YATA data."); }
            }
        });
    }

    function fetchTornStatsSpies(btnElement, forcePrompt = false, specificFacId = null) {
        const key = GM_getValue('tsApiKey', '');
        if (!key) {
            if (forcePrompt) alert("Please enter a TornStats API Key and save first.");
            else {
                const originalText = btnElement.innerText;
                btnElement.innerText = "No API Key";
                setTimeout(() => btnElement.innerText = originalText, 2000);
            }
            return;
        }

        let facId = specificFacId;

        if (!facId && window.location.href.includes("factions.php")) {
            const urlParams = new URLSearchParams(window.location.search);
            facId = urlParams.get('ID');
            if (!facId) {
                const facInfo = document.querySelector('.faction-info');
                if (facInfo) facId = facInfo.getAttribute("data-faction");
            }
        }

        if (forcePrompt) {
            const promptInput = prompt("Enter target Faction ID to pull spies for:", GM_getValue('lastTsFactionId', '48640'));
            if (promptInput !== null) {
                facId = promptInput.replace(/\D/g, '');
                if (facId) GM_setValue('lastTsFactionId', facId);
            } else {
                return; // User cancelled prompt
            }
        } else if (!facId) {
            facId = GM_getValue('lastTsFactionId', null);
        }

        if (!facId) {
            if (forcePrompt) return;
            const originalText = btnElement.innerText;
            btnElement.innerText = "No Fac ID";
            setTimeout(() => btnElement.innerText = originalText, 2000);
            return;
        }

        const originalText = btnElement.innerText;
        btnElement.innerText = `Fetching...`;
        btnElement.disabled = true;

        GM_xmlhttpRequest({
            method: "GET",
            url: `https://www.tornstats.com/api/v2/${key}/spy/faction/${facId}`,
            onload: function (response) {
                btnElement.disabled = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (!data.status) {
                        if (forcePrompt) alert("TornStats Error: " + data.message);
                        else {
                            btnElement.innerText = "Error";
                            setTimeout(() => btnElement.innerText = originalText, 2000);
                        }
                        return;
                    }

                    let imported = 0;
                    for (const [xid, member] of Object.entries(data.faction?.members || {})) {
                        if (member.spy && member.spy.total > 0) {
                            spyCache[xid] = {
                                total: member.spy.total,
                                timestamp: member.spy.timestamp,
                                source: 'TornStats'
                            };
                            imported++;
                        }
                    }
                    GM_setValue('qaSpyCache', spyCache);

                    if (forcePrompt) {
                        alert(`Successfully imported ${imported} spies for Faction #${facId}!`);
                        location.reload();
                    } else {
                        btnElement.innerText = `Imported ${imported}!`;
                        btnElement.style.background = "#4caf50";
                        setTimeout(() => {
                            btnElement.innerText = originalText;
                            btnElement.style.background = ""; // Restore to class style
                        }, 3000);

                        // Force refresh badge for the profile
                        const currentXid = new URL(window.location.href).searchParams.get("XID");
                        if (currentXid) scheduleFetch(currentXid);
                    }
                } catch (e) {
                    if (forcePrompt) alert("Failed to parse TornStats data.");
                    else {
                        btnElement.innerText = "Error";
                        setTimeout(() => btnElement.innerText = originalText, 2000);
                    }
                }
            }
        });
    }

