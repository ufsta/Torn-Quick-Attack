function renderPresetBar() {
    presetBar.innerHTML = '';

    Object.keys(getCustomPresets()).forEach(name => {
        const chip = makeChip(name, 'c:' + name);
        chip.onclick = () => {
            const p = getCustomPresets()[name];
            if (!p) return;
            activePreset = 'c:' + name;
            applyPreset(p);
            renderPresetBar();
        };
        if (editMode) {
            chip.appendChild(makeIcon('✎', 'Rename', () => {
                const renamed = (prompt('Rename preset:', name) || '').trim().slice(0, 24);
                if (!renamed || renamed === name) return;
                const custom = getCustomPresets();
                if (custom[renamed]) { alert('That name is already used.'); return; }
                const next = {};
                Object.keys(custom).forEach(k => { next[k === name ? renamed : k] = custom[k]; });
                GM_setValue('qaFilterPresets', next);
                if (activePreset === 'c:' + name) activePreset = 'c:' + renamed;
                renderPresetBar();
            }));
            chip.appendChild(makeIcon('↻', 'Replace with current filters', () => {
                if (!confirm(`Replace "${name}" with the current filters?`)) return;
                const custom = getCustomPresets();
                custom[name] = snapshotFilters();
                GM_setValue('qaFilterPresets', custom);
                activePreset = 'c:' + name;
                renderPresetBar();
            }));
            chip.appendChild(makeIcon('×', 'Delete', () => {
                if (!confirm(`Delete "${name}"?`)) return;
                const custom = getCustomPresets();
                delete custom[name];
                GM_setValue('qaFilterPresets', custom);
                if (activePreset === 'c:' + name) activePreset = '';
                renderPresetBar();
            }));
        }
        presetBar.appendChild(chip);
    });

    const add = makeChip('+ Save', '', 'qa-add');
    add.title = 'Save current filters as a preset';
    add.onclick = () => {
        const current = activePreset.startsWith('c:') ? activePreset.slice(2) : '';
        const name = (prompt('Name for this preset:', current) || '').trim().slice(0, 24);
        if (!name) return;
        const custom = getCustomPresets();
        if (custom[name] && !confirm(`Overwrite "${name}"?`)) return;
        custom[name] = snapshotFilters();
        GM_setValue('qaFilterPresets', custom);
        activePreset = 'c:' + name;
        renderPresetBar();
    };
    presetBar.appendChild(add);

    const edit = makeChip(editMode ? 'Done' : '✎ Edit', '', 'qa-add' + (editMode ? ' qa-on' : ''));
