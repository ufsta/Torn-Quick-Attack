    const CHAIN_REFRESH_MS = 24 * 60 * 60 * 1000;
    let chainBusy = false;

    function getChainFilters() {
        return {
            minlevel: GM_getValue('qaChainMinLvl', null),
            maxlevel: GM_getValue('qaChainMaxLvl', null),
            minff: GM_getValue('qaChainMinFF', null),
            maxff: GM_getValue('qaChainMaxFF', 2.5),
            inactive: GM_getValue('qaChainInactive', true),
            factionless: GM_getValue('qaChainFactionless', false)
        };
    }

    function chainStore() {
        try {
            let v = GM_getValue('qaChainTargets', null);
            if (typeof v === 'string') v = JSON.parse(v);
            return (v && Array.isArray(v.targets)) ? v : null;
        } catch (e) { return null; }
    }

    function chainToast(msg) {
        const old = document.getElementById('qa-chain-toast');
        if (old) old.remove();
        const t = document.createElement('div');
        t.id = 'qa-chain-toast';
        t.textContent = msg;
        t.style.cssText = 'position:fixed;bottom:90px;left:50%;transform:translateX(-50%);background:#33238a;color:#fff;padding:8px 14px;border-radius:8px;font-size:13px;z-index:2147483647;box-shadow:0 2px 12px rgba(0,0,0,.4);max-width:80%;text-align:center;';
        document.body.appendChild(t);
        setTimeout(() => t.remove(), 3000);
    }

    function fetchChainTargets(force, done) {
        const key = GM_getValue('ffApiKey', '');
        if (!key) { if (done) done(false, 'No FF Scouter API key set'); return; }

        const f = getChainFilters();
        const store = chainStore();
        const sameFilters = store && JSON.stringify(store.filters) === JSON.stringify(f);
        const fresh = store && sameFilters && store.targets.length && (Date.now() - store.ts < CHAIN_REFRESH_MS);
        if (!force && fresh) { if (done) done(true); return; }
        if (chainBusy) return;
        chainBusy = true;

        const q = new URLSearchParams({ key });
        if (f.minlevel != null) q.append('minlevel', f.minlevel);
        if (f.maxlevel != null) q.append('maxlevel', f.maxlevel);
        if (f.minff != null) q.append('minff', f.minff);
        if (f.maxff != null) q.append('maxff', f.maxff);
        q.append('inactiveonly', f.inactive ? 1 : 0);
        q.append('factionless', f.factionless ? 1 : 0);
        q.append('limit', 50);

        GM_xmlhttpRequest({
            method: 'GET',
            url: `https://ffscouter.com/api/v1/get-targets?${q.toString()}`,
            onload: function (r) {
                chainBusy = false;
                try {
                    const data = JSON.parse(r.responseText);
                    if (data.error) throw new Error(data.error);
                    const targets = (data.targets || []).map(t => String(t.player_id)).filter(Boolean);
                    GM_setValue('qaChainTargets', { targets, filters: f, ts: Date.now(), index: 0 });
                    if (done) done(targets.length > 0, targets.length ? '' : 'No targets match your filters');
                } catch (e) {
                    if (done) done(false, e.message || 'Failed to load targets');
                }
            },
            onerror: function () {
                chainBusy = false;
                if (done) done(false, 'Network error loading targets');
            }
        });
    }

    function takeChainTarget() {
        const s = chainStore();
        if (!s || !s.targets.length) return null;
        const i = (s.index || 0) % s.targets.length;
        const id = s.targets[i];
        s.index = i + 1;
        GM_setValue('qaChainTargets', s);
        return { id, wrapped: s.index >= s.targets.length };
    }

    function openChainTarget(id) {
        const url = GM_getValue('qaChainLink', 'attack') === 'profile'
            ? `https://www.torn.com/profiles.php?XID=${id}`
            : `https://www.torn.com/page.php?sid=attack&user2ID=${id}`;
        if (GM_getValue('qaChainTab', 'newtab') === 'sametab') window.location.href = url;
        else window.open(url, '_blank');
    }

    function createChainButton() {
        const existing = document.getElementById('qa-chain-btn');
        if (!GM_getValue('qaChainEnabled', true) || !GM_getValue('ffApiKey', '')) {
            if (existing) existing.remove();
            return;
        }
        if (existing || !document.body) return;

        const btn = document.createElement('div');
        btn.id = 'qa-chain-btn';
        btn.textContent = 'FF';
        btn.title = 'Next chain target';
        btn.style.cssText = 'position:fixed;top:40%;right:0;z-index:9999;background:#2e8b3a;color:#fff;font-weight:bold;font-size:14px;padding:8px 10px;border-radius:6px 0 0 6px;cursor:pointer;user-select:none;box-shadow:-1px 1px 6px rgba(0,0,0,.4);';

        btn.onclick = (e) => {
            e.preventDefault(); e.stopPropagation();
            dismissKeyboard();
            const t = takeChainTarget();
            if (!t) {
                chainToast('Loading targets...');
                fetchChainTargets(true, (ok, msg) => chainToast(ok ? 'Targets loaded - tap FF again' : msg));
                return;
            }
            openChainTarget(t.id);
            if (t.wrapped) fetchChainTargets(true);   // end of list: grab a fresh one in the background
        };

        document.body.appendChild(btn);
    }

    function startChainButton() {
        createChainButton();
        if (GM_getValue('qaChainEnabled', true) && GM_getValue('ffApiKey', '')) fetchChainTargets(false);
    }
    // ---------- end chain button ----------

    function scan() {
        const currentUrl = window.location.href;

        if (currentUrl.includes("factionWarfare")) {
            document.body.classList.add("qa-warfare");
            return;
        } else {
            document.body.classList.remove("qa-warfare");
        }

        if (isExcludedHofPage(currentUrl)) {
            document.body.classList.add("qa-hof-faction");
            document.querySelectorAll('a[href*="factions.php"], img[src*="factiontags"], img[src*="factions"]').forEach(el => {
                if (el.style.display === 'none') el.style.display = '';
            });
            document.querySelectorAll('.TDup_GhostOverlay').forEach(el => el.remove());
            injectMiniProfileStats();
            return;
        } else {
            document.body.classList.remove("qa-hof-faction");
        }

        if (currentUrl.includes("tab=crimes")) {
            return;
        }

        if (currentUrl.includes("sid=attackLog")) {
            document.body.classList.add("qa-attack-log");
        } else {
            document.body.classList.remove("qa-attack-log");
        }

        if (currentUrl.includes("forums.php")) {
            document.body.classList.add("qa-forum");
        } else {
            document.body.classList.remove("qa-forum");
        }

        hideFactionLogos();
        hideRankedWarScoreColumn();
          hideRankedWarScoreColumn();
  updateWarRespectColumn();
        injectMiniProfileStats();

        if (currentUrl.includes("profiles.php")) {
            injectProfileSettingsPanel();
            injectFlightStats();
            injectProfileStats();
        }

        if (currentUrl.includes("factions.php") || currentUrl.includes("war.php")) {
            injectFilterBox();
        }

        if (currentUrl.includes("forums.php")) {
            processForumPage();
        }

        const isPageActive = PAGE_CONFIG.some(
            config => config.check(currentUrl) && getSetting(config.key)
        );

        if (isPageActive && !currentUrl.includes("tab=crimes") && !currentUrl.includes("factionWarfare") && !isExcludedHofPage(currentUrl)) {
            document.querySelectorAll(
                'a[href*="profiles.php?XID="], a[href*="bazaar.php?userId="], .bazaar-player-link, .bazaar-trader-name, .bazaar-stat-link'
            ).forEach(link => {
                if (link.closest(CHAT_AND_NAV_IGNORE_SELECTOR) || link.closest('#mini-profile-root, [class*="mini-profile"], [class*="miniProfile"]')) {
                    return;
                }

                const xid = getPlayerIdFromLink(link);
                if (xid) {
                    if (link.classList.contains('bazaar-player-link') ||
                        link.classList.contains('bazaar-trader-name') ||
                        link.classList.contains('bazaar-stat-link') ||
                        link.closest('.bazaar-info-container, .bazaar-listing-card')) {

                        injectBazaarBadge(link, xid);
                    } else {
                        injectGridBadge(link, xid);
                    }
                }
            });
        }

        // Apply Gauges to Honor Bars if enabled in settings
        document.querySelectorAll('.honor-text-wrap').forEach(bar => {
            if (bar.dataset.qaHonorAttached) return;

            let xid = null;
            if (currentUrl.includes("profiles.php?XID=")) {
                xid = new URL(currentUrl).searchParams.get("XID");
            }

            if (!xid) {
                const container = bar.closest('li, tr, .user-wrap, [class*="userInfoBox"], .bazaar-info-container, .info-wrap, .poster, .post');
                if (container) {
                    const link = container.querySelector('a[href*="profiles.php?XID="], a[href*="userID="]');
                    xid = getPlayerIdFromLink(link);
                }
            }

            if (xid) {
                bar.classList.add(`qa-honor-${xid}`);
                bar.dataset.qaHonorAttached = "true";

                if (statCache[xid] && statCache[xid].ffValue != null && getSetting('qaEnableGauges', false)) {
                    applyGauge(bar, statCache[xid].ffValue);
                } else {
                    scheduleFetch(xid);
                }
            }
        });
    }

    let scanTimeout = null;
    function debouncedScan() {
        if (scanTimeout) return;
        scanTimeout = setTimeout(() => {
            scan();
            scanTimeout = null;
        }, 100);
    }

    new MutationObserver(debouncedScan).observe(document.body, {
        childList: true,
        subtree: true
    });

    window.addEventListener('hashchange', scan);

    scan();
    startChainButton();

})();
