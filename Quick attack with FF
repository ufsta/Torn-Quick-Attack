        if (!a) return;
        try {
            const id = new URL(a.href, 'https://www.torn.com').searchParams.get('ID');
            if (id && !ids.includes(id)) ids.push(id);
        } catch (e) {}
    });
    return ids;
}

function resortNow() {
    const saved = GM_getValue('qaFilterSettings', {});
