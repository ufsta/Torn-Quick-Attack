    // Wiki: base respect is linear, 1.00 at level 1 to 1.50 at level 100.
// Past hit 10, a chain scale multiplier of 0.25 * log10(chain) + 0.75 applies.

function getLiveChainLength() {
    const chainEl = document.querySelector('.chain-value, [class*="chainValue"], [class*="counter-chain"]');
    if (chainEl) {
        const val = parseInt(chainEl.innerText.replace(/,/g, ''));
        if (!isNaN(val)) return val;
    }
    return parseInt(GM_getValue('qaChainLength', 0)) || 0;
}

function estRespect(level, ff) {
    if (!level || ff == null || isNaN(ff)) return null;

    // Base respect: 1.00 at level 1 to 1.50 at level 100[cite: 1].
    const base = Math.floor((1 + (Math.min(level, 100) / 200)) * 100) / 100;

    // Fair Fight multiplier: capped at 3x[cite: 1].
    const fairFight = Math.min(Math.max(ff, 1), 3);

    // Automatically grab live chain length instead of relying only on stored memory
    const chain = getLiveChainLength();
    const chainScale = chain > 10
        ? 0.25 * Math.log10(chain) + 0.75
        : 1;

    // Ranked War opponents receive the 2x warring bonus[cite: 1].
    const warringMultiplier = 2;

    return base * fairFight * chainScale * warringMultiplier;
}

